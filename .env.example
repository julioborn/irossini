# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cifrado de credenciales de Mercado Pago en DB (AES-256-GCM) ─
# Clave de 32 bytes en base64. Generar con: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

# ── Mercado Pago — Marketplace / OAuth ───────────────────────────
MP_APP_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=
MP_MARKETPLACE_FEE_PERCENT=
MP_WEBHOOK_SECRET=

# ── Branding (nombre de marca todavía sin definir) ───────────────
NEXT_PUBLIC_BRAND_NAME=
# URL pública del deployment. Socio, playero y admin viven en la misma app/dominio.
NEXT_PUBLIC_APP_URL=

# Red operada por este deployment. Modelo white-label: en Fase 1 cada red se
# despliega por separado (dominio/env propios), así que el registro de socios
# necesita saber a qué red pertenecen sin tener que resolverlo por subdominio.
NEXT_PUBLIC_RED_ID=

# ── Web Push (VAPID) ─────────────────────────────────────────────
# La pública se expone al cliente (NEXT_PUBLIC_) para suscribir al navegador;
# la privada queda solo en el servidor para firmar los envíos.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@example.com

# ── Firebase Cloud Messaging (push nativo vía Capacitor) ─────────
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
